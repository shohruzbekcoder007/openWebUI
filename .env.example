# =============================================================================
# Open WebUI AI Platform - Environment Configuration
# Copy to .env and adjust values. No code changes needed between local/prod.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment mode: local | production
# -----------------------------------------------------------------------------
ENVIRONMENT=local
COMPOSE_PROJECT_NAME=openwebui-platform

# -----------------------------------------------------------------------------
# Domain & URLs (no hardcoded IPs)
# Local:  leave BASE_DOMAIN empty or use localhost
# Prod:   set BASE_DOMAIN=ai.example.com
# -----------------------------------------------------------------------------
BASE_DOMAIN=localhost
# Public URL used by Open WebUI (must match how users access the UI)
# Local:  http://localhost:3000
# Prod:   https://ai.example.com
WEBUI_URL=http://localhost:3000
# Public API base (optional; used in docs / health metadata)
PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Ports (host-published)
# -----------------------------------------------------------------------------
OPENWEBUI_PORT=3000
GATEWAY_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
REDIS_PORT=6379
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Open WebUI
# Official image; customized only via env vars
# -----------------------------------------------------------------------------
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
# Secret for sessions / JWT (generate a strong random value in production)
WEBUI_SECRET_KEY=change-me-to-a-long-random-secret-key
# Enable login UI (true recommended for production)
WEBUI_AUTH=true
# Default admin (first-run signup still applies if auth is enabled)
# ENABLE_SIGNUP=true allows first user registration
ENABLE_SIGNUP=true
# Point Open WebUI ONLY at the Gateway (Docker service name on internal network)
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=http://gateway:8000/v1
# API key Open WebUI sends to the Gateway (must match GATEWAY_API_KEYS)
OPENAI_API_KEY=sk-gateway-dev-key
# Required so Open WebUI sends X-OpenWebUI-Chat-Id to the Gateway (for agent session_id)
ENABLE_FORWARD_USER_INFO_HEADERS=true
# Disable built-in Ollama so models come only from the Gateway
ENABLE_OLLAMA_API=false
# Optional: keep Open WebUI model list fresh
MODELS_CACHE_TTL=30
# Max upload size (MB) for RAG / files
RAG_FILE_MAX_SIZE=100
# Timezone
TZ=UTC

# -----------------------------------------------------------------------------
# Gateway (FastAPI)
# -----------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT_INTERNAL=8000
LOG_LEVEL=INFO
# Comma-separated API keys accepted by the Gateway
# Open WebUI uses OPENAI_API_KEY; external clients may use others
GATEWAY_API_KEYS=sk-gateway-dev-key
# Optional JWT secret for future bearer/JWT auth
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Rate limiting (requests per minute per API key; 0 = disabled)
RATE_LIMIT_RPM=120
# CORS origins (comma-separated). Local includes Open WebUI port.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Path to agents config (mounted volume in Docker)
AGENTS_CONFIG_PATH=/app/config/agents.yaml
# Request timeout defaults (seconds)
DEFAULT_AGENT_TIMEOUT=120
# Enable request/response body logging (verbose; disable in prod if sensitive)
LOG_REQUEST_BODIES=false
# Future: MCP / RAG feature flags
ENABLE_MCP=false
ENABLE_RAG=false

# -----------------------------------------------------------------------------
# Redis (optional – used for rate limiting / cache when enabled)
# -----------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Open WebUI database — PostgreSQL container (service name: postgres)
# Volume: postgres-data → /var/lib/postgresql/data
# Uploads/cache still use open-webui-data → /app/backend/data
# -----------------------------------------------------------------------------
POSTGRES_ENABLED=true
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=openwebui
# Host inside Docker network is "postgres" (not localhost)
DATABASE_URL=postgresql://openwebui:change-me-postgres-password@postgres:5432/openwebui
# SQLite alternative (no postgres service needed):
# DATABASE_URL=sqlite:////app/backend/data/webui.db

# -----------------------------------------------------------------------------
# Nginx (production profile)
# -----------------------------------------------------------------------------
# Enable TLS termination in nginx (requires certs under nginx/ssl/)
NGINX_SSL_ENABLED=false
# Certificate paths inside the nginx container
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem
# Client max body size for large uploads
NGINX_CLIENT_MAX_BODY_SIZE=100m
# Proxy read timeout (streaming chats can be long)
NGINX_PROXY_READ_TIMEOUT=600s

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Docker log driver options applied via compose
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# -----------------------------------------------------------------------------
# Hermes Agent endpoints (override defaults in config/agents.yaml)
# Local mock (compose service): http://mock-agent:9010
# Host process:                 http://host.docker.internal:PORT
# Remote production:            https://agriculture.internal.example.com
# -----------------------------------------------------------------------------
HERMES_AGRICULTURE_BASE_URL=http://mock-agent:9010
HERMES_GIS_BASE_URL=http://mock-agent:9010
HERMES_STATISTICS_BASE_URL=http://mock-agent:9010
HERMES_PRESS_RELIZ_BASE_URL=http://mock-agent:9010
HERMES_PROGRAMMER_BASE_URL=http://mock-agent:9010
HERMES_TRANSLATOR_BASE_URL=http://mock-agent:9010

HERMES_AGRICULTURE_API_KEY=
HERMES_GIS_API_KEY=
HERMES_STATISTICS_API_KEY=
HERMES_PRESS_RELIZ_API_KEY=
HERMES_PROGRAMMER_API_KEY=
HERMES_TRANSLATOR_API_KEY=

HERMES_AGRICULTURE_MODEL=agriculture-default
HERMES_GIS_MODEL=gis-default
HERMES_STATISTICS_MODEL=statistics-default
HERMES_PRESS_RELIZ_MODEL=press-reliz-default
HERMES_PROGRAMMER_MODEL=programmer-default
HERMES_TRANSLATOR_MODEL=translator-default

# Press reliz reads the PDF itself (pdf_extract + a 27B model), so it needs far
# longer than the 120s default before the Gateway gives up with a 504.
HERMES_PRESS_RELIZ_TIMEOUT=900

# -----------------------------------------------------------------------------
# Attachment passthrough (Gateway -> Open WebUI file store)  [OPTIONAL]
#
# Not needed with the Hermes File Passthrough filter
# (config/openwebui/hermes_file_passthrough.py): the filter runs inside Open
# WebUI, reads the bytes from the file store itself and puts them in the
# request, so the Gateway never calls back.
#
# Set these only for the fallback path, where the Gateway fetches a file it
# was handed as a bare id via GET /api/v1/files/{id}/content. That endpoint
# needs an Open WebUI API key from an ADMIN account
# (Admin -> Authentication -> API Keys to enable, then Settings -> Account).
# Empty OPENWEBUI_API_KEY simply leaves the fallback off.
# -----------------------------------------------------------------------------
OPENWEBUI_BASE_URL=http://open-webui:8080
OPENWEBUI_API_KEY=
OPENWEBUI_FILE_MAX_BYTES=52428800

# Stop Open WebUI from chunking/embedding attachments and from wrapping them in
# its "### Task: answer from the context" template (global, all models).
# Same switch as Admin -> Settings -> Documents -> "Bypass Embedding and Retrieval".
BYPASS_EMBEDDING_AND_RETRIEVAL=false
